# V3 production server
HOST=0.0.0.0
PORT=3001

# Allowed browser origin for Socket.IO/CORS. Use the deployed public origin in production.
WEB_ORIGIN=http://localhost:5173

# Optional absolute path to a pre-built Vue dist directory.
# WEB_ROOT=/app/apps/web/dist

# Optional production simulator opt-in. Leave unset for normal production builds.
# VITE_ENABLE_SIMULATOR=true
