{
  "name": "loup-garou-ultimate",
  "version": "3.0.0-dev",
  "private": true,
  "description": "Multiplayer companion app for Loups Garous de Thiercelieux",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node apps/server/dist/index.js",
    "start:v3": "pnpm --filter @lgu/server start",
    "simulator": "pnpm --filter @lgu/web dev --mode simulator --host 0.0.0.0 --port 5174 --open /simulator",
    "dev": "pnpm dev:v3",
    "dev:legacy": "nodemon server.js",
    "test:legacy": "node test/petite-fille-rule.test.js && node test/role-assignment.test.js",
    "dev:v3": "pnpm --parallel --filter @lgu/web --filter @lgu/server run dev",
    "build:v3": "pnpm --filter @lgu/contracts build && pnpm --filter @lgu/game-core build && pnpm --filter @lgu/game-projection build && pnpm --filter @lgu/web build && pnpm --filter @lgu/server build",
    "typecheck:v3": "pnpm -r --if-present run typecheck",
    "test:v3": "pnpm -r --if-present run test",
    "test": "pnpm test:legacy && pnpm test:v3",
    "test:e2e": "playwright test",
    "test:e2e:simulator": "playwright test --config playwright.simulator.config.ts",
    "test:e2e:all": "pnpm test:e2e && pnpm test:e2e:simulator",
    "start:legacy": "node server.js",
    "build": "pnpm build:v3",
    "heroku-postbuild": "pnpm build:v3"
  },
  "keywords": [
    "loup-garou",
    "werewolf",
    "board-game",
    "multiplayer"
  ],
  "author": "Marc Prats",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "nodemon": "^3.0.1"
  }
}
